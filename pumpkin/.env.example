# Copia en el servidor como /opt/pumpkin-accesos/.env (nunca a git).
POSTGRES_PASSWORD=
# 32+ caracteres; firma sesiones y enlaces directos. Cambiarlo cierra todas las sesiones.
PUMPKIN_SECRET=
# usuario:clave:rol:Nombre;…  rol = admin (supervisión) | puerta (PDA: solo escáner)
PUMPKIN_USUARIOS=admin:cambia-esto:admin:Supervisión;puerta1:cambia-esto:puerta:Puerta 1
# 0 = sin límite de personas dentro
PUMPKIN_AFORO=0
# Hora (CDMX) en que cambia la jornada: con 6, de 06:00 a 05:59 es la misma noche.
PUMPKIN_CORTE_HORA=6
