# HTTP → ACME + redirect; HTTPS → panel de control (eventos_panel_web)
# Se carga junto a zz-demo.conf en el nginx compartido (nginx_registro_proxy).
#
# FICTI panel only (DigitalOcean). No proxy a Hetzner / Nest / terror.

server {
    listen 80;
    listen [::]:80;
    server_name panel.experiencebt.com.mx;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name panel.experiencebt.com.mx;

    ssl_certificate     /etc/letsencrypt/live/panel.experiencebt.com.mx/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.experiencebt.com.mx/privkey.pem;

    resolver 127.0.0.11 valid=30s ipv6=off;
    client_max_body_size 8m;

    # El panel expone datos personales: fuera de buscadores y del historial ajeno.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        set $panel_backend "http://eventos_panel_web:5000";
        proxy_pass $panel_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
